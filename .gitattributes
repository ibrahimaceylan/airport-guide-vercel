# ========================================
# Git Attributes — Istanbul Airport Guide (v2)
# Ensures consistent line endings and merges
# ========================================

# Auto normalize text files
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary

# Lockfiles and database files as binary
yarn.lock binary
package-lock.json binary
prisma/dev.db binary
